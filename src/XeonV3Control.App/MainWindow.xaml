<Window
    x:Class="XeonV3Control.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE950;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            Background="Transparent"
            PaneDisplayMode="Auto"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="{StaticResource LayoutMediumBreakpoint}"
            ExpandedModeThresholdWidth="{StaticResource LayoutWideBreakpoint}"
            OpenPaneLength="{StaticResource LayoutNavigationOpenPaneLength}"
            CompactPaneLength="{StaticResource LayoutNavigationCompactPaneLength}"
            SelectionChanged="ShellNavigationSelectionChanged"
            ItemInvoked="ShellNavigationItemInvoked"
            DisplayModeChanged="ShellNavigationDisplayModeChanged">

            <NavigationView.PaneFooter>
                <TextBlock
                    x:Name="CurrentFileLabel"
                    Visibility="Collapsed"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    HorizontalAlignment="Stretch"
                    TextAlignment="Center"
                    FontSize="{StaticResource LayoutPaneCaptionFontSize}"
                    Opacity="{StaticResource LayoutFileLabelOpacity}"
                    Margin="{StaticResource LayoutCurrentFileMargin}"
                    IsTextSelectionEnabled="True" />
            </NavigationView.PaneFooter>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SourceNavigationItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AnalysisNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SecureBootNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DriversNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="TurboBoostNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PersonalizationNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE91B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="TpmNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SaveNavigationItem"
                    IsEnabled="False"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ShellGrid">
                <!-- Content responsiveness is based on the actual NavigationView content viewport,
                     not the outer window width. See ContentScrollerSizeChanged. -->
                <!-- NavigationView content uses the Mica foundation directly. Cards are reserved for grouped content. -->
                <Grid
                    x:Name="ContentHost"
                    Margin="{StaticResource LayoutContentHostMarginDefault}">

                    <ScrollViewer
                        x:Name="ContentScroller"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        HorizontalContentAlignment="Stretch"
                        SizeChanged="ContentScrollerSizeChanged">
                        <StackPanel
                            x:Name="ContentPanel"
                            MaxWidth="{StaticResource LayoutContentMaxWidth}"
                            Padding="{StaticResource LayoutContentPaddingNarrow}"
                            HorizontalAlignment="Center">

                            <TextBlock
                                x:Name="CurrentImageContextLabel"
                                Visibility="Collapsed"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Margin="0,0,0,8"
                                IsTextSelectionEnabled="True" />

                            <StackPanel
                                x:Name="SourcePage"
                                Spacing="{StaticResource LayoutPageSpacing}"
                                Background="Transparent"
                                DragOver="SourceDragOver"
                                Drop="SourceDrop">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="Heading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="Subtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>

                                <InfoBar
                                    x:Name="SupportBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational" />

                                <Grid
                                    x:Name="ActionCards"
                                    ColumnSpacing="0"
                                    RowSpacing="{StaticResource LayoutStackedActionSpacing}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="PrimaryActionColumn" Width="*" />
                                        <ColumnDefinition x:Name="SecondaryActionColumn" Width="0" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="FileCard" Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="{StaticResource LayoutCardContentSpacing}">
                                            <FontIcon
                                                Glyph="&#xE8A5;"
                                                HorizontalAlignment="Left"
                                                FontSize="{StaticResource LayoutCardIconFontSize}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="FileTitle" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="FileHint"
                                                TextWrapping="Wrap"
                                                MinHeight="{StaticResource LayoutHintMinimumHeight}"
                                                Opacity="{StaticResource LayoutHintTextOpacity}"
                                                IsTextSelectionEnabled="True" />
                                            <Button
                                                x:Name="OpenButton"
                                                Click="OpenFile"
                                                Style="{StaticResource PrimaryActionButtonStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="SystemCard"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="{StaticResource LayoutCardContentSpacing}">
                                            <FontIcon
                                                Glyph="&#xE950;"
                                                HorizontalAlignment="Left"
                                                FontSize="{StaticResource LayoutCardIconFontSize}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="SystemTitle" Style="{StaticResource SectionTitleTextStyle}" />
                                            <TextBlock
                                                x:Name="SystemHint"
                                                TextWrapping="Wrap"
                                                MinHeight="{StaticResource LayoutHintMinimumHeight}"
                                                Opacity="{StaticResource LayoutHintTextOpacity}"
                                                IsTextSelectionEnabled="True" />
                                            <Button x:Name="ReadButton" Click="ReadSystem" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="DropHint"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True" />

                                <StackPanel
                                    x:Name="EmptyPanel"
                                    Spacing="{StaticResource LayoutCardContentSpacing}"
                                    Padding="{StaticResource LayoutEmptyPadding}"
                                    HorizontalAlignment="Center">
                                    <FontIcon
                                        Glyph="&#xE7C3;"
                                        FontSize="{StaticResource LayoutEmptyIconFontSize}"
                                        Opacity="{StaticResource LayoutEmptyIconOpacity}" />
                                    <TextBlock
                                        x:Name="EmptyTitle"
                                        Style="{StaticResource SectionTitleTextStyle}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="EmptyHint"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Opacity="{StaticResource LayoutSecondaryTextOpacity}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                x:Name="AnalysisPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="AnalysisHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="AnalysisSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel x:Name="Results" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="SecureBootPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="SecureBootHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="SecureBootSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="SecureBootNoticePanel"
                                    Spacing="{StaticResource LayoutNoticeStackSpacing}">
                                    <InfoBar
                                        x:Name="SecureBootNoticeBar"
                                        IsOpen="False"
                                        IsClosable="True" />
                                    <StackPanel
                                        x:Name="SecureBootIssueHost"
                                        Spacing="{StaticResource LayoutNoticeStackSpacing}" />
                                </StackPanel>
                                <StackPanel x:Name="SecureBootResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="DriversPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="DriversHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="DriversSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel x:Name="DriversResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="TurboBoostPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="TurboBoostHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="TurboBoostSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <InfoBar
                                    x:Name="TurboBoostNoticeBar"
                                    IsOpen="False"
                                    IsClosable="True" />
                                <StackPanel x:Name="TurboBoostResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="PersonalizationPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="PersonalizationHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="PersonalizationSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <InfoBar
                                    x:Name="PersonalizationNoticeBar"
                                    IsOpen="False"
                                    IsClosable="True" />
                                <StackPanel x:Name="PersonalizationResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="TpmPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="TpmHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="TpmSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <InfoBar x:Name="TpmNoticeBar" IsOpen="False" IsClosable="True" />
                                <StackPanel x:Name="TpmResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="SavePage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="SaveHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="SaveSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <InfoBar x:Name="SaveNoticeBar" IsOpen="False" IsClosable="True" />
                                <StackPanel x:Name="SaveResults" Spacing="{StaticResource LayoutResultsSpacing}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="SettingsPage"
                                Visibility="Collapsed"
                                Spacing="{StaticResource LayoutPageSpacing}">
                                <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                    <TextBlock x:Name="SettingsHeading" Style="{StaticResource PageHeadingTextStyle}" />
                                    <TextBlock
                                        x:Name="SettingsSubtitle"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <InfoBar x:Name="SettingsNotice" IsOpen="False" IsClosable="True" />
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="{StaticResource LayoutResultsSpacing}">
                                        <TextBlock x:Name="AppearanceTitle" Style="{StaticResource SectionTitleTextStyle}" />
                                        <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                            <TextBlock
                                                x:Name="LanguageSettingLabel"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                            <ComboBox
                                                x:Name="LanguageComboBox"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="LanguageSelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Spacing="{StaticResource LayoutHeaderStackSpacing}">
                                            <TextBlock
                                                x:Name="ThemeSettingLabel"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True" />
                                            <ComboBox
                                                x:Name="ThemeComboBox"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="ThemeSelectionChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel Spacing="{StaticResource LayoutSectionSpacing}">
                                        <TextBlock x:Name="AboutTitle" Style="{StaticResource SectionTitleTextStyle}" />
                                        <StackPanel
                                            x:Name="AboutDetails"
                                            Spacing="{StaticResource LayoutCardContentSpacing}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        x:Name="StatusHost"
                        MaxWidth="{StaticResource LayoutContentMaxWidth}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Canvas.ZIndex="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="Collapsed"
                        MinHeight="{StaticResource LayoutStatusMinimumHeight}"
                        Padding="{StaticResource LayoutStatusPaddingNarrow}"
                        BorderThickness="{StaticResource LayoutStatusBorderThickness}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <InfoBar
                            x:Name="StatusBar"
                            IsOpen="False"
                            IsClosable="True"
                            Closed="StatusBarClosed"
                            VerticalAlignment="Center" />
                        <StackPanel
                            x:Name="BusyPanel"
                            Visibility="Collapsed"
                            Spacing="{StaticResource LayoutBusySpacing}"
                            VerticalAlignment="Center">
                            <ProgressBar x:Name="Progress" Maximum="100" />
                            <Grid ColumnSpacing="{StaticResource LayoutStackedActionSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="BusyLabel"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                                <Button
                                    x:Name="CancelButton"
                                    Grid.Column="1"
                                    Click="CancelOperation" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
