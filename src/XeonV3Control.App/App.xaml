<Application
    x:Class="XeonV3Control.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout tokens. Measurements follow the Windows 4-epx grid unless they are type-ramp values. -->
            <x:Double x:Key="LayoutContentMaxWidth">1280</x:Double>
            <x:Double x:Key="LayoutNavigationOpenPaneLength">240</x:Double>
            <x:Double x:Key="LayoutNavigationCompactPaneLength">48</x:Double>
            <x:Double x:Key="LayoutMediumBreakpoint">641</x:Double>
            <x:Double x:Key="LayoutWideBreakpoint">1008</x:Double>
            <!-- Internal content breakpoints are based on the NavigationView viewport, not the outer window. -->
            <x:Double x:Key="LayoutActionCardsTwoColumnMinWidth">1120</x:Double>
            <x:Double x:Key="LayoutPaneCaptionFontSize">12</x:Double>
            <x:Double x:Key="LayoutCardIconFontSize">28</x:Double>
            <x:Double x:Key="LayoutEmptyIconFontSize">40</x:Double>
            <x:Double x:Key="LayoutHintMinimumHeight">40</x:Double>
            <x:Double x:Key="LayoutStatusMinimumHeight">80</x:Double>
            <x:Double x:Key="LayoutPageSpacing">24</x:Double>
            <x:Double x:Key="LayoutCardContentSpacing">12</x:Double>
            <x:Double x:Key="LayoutResultsSpacing">16</x:Double>
            <x:Double x:Key="LayoutHeaderStackSpacing">8</x:Double>
            <x:Double x:Key="LayoutSectionSpacing">16</x:Double>
            <x:Double x:Key="LayoutBusySpacing">12</x:Double>
            <x:Double x:Key="LayoutDynamicCardSpacing">16</x:Double>
            <x:Double x:Key="LayoutNoticeSpacing">4</x:Double>
            <x:Double x:Key="LayoutNoticeStackSpacing">8</x:Double>
            <x:Double x:Key="LayoutRowColumnSpacing">16</x:Double>
            <x:Double x:Key="LayoutRowLabelMaxWidth">160</x:Double>
            <x:Double x:Key="LayoutInlineIconSpacing">8</x:Double>
            <x:Double x:Key="LayoutInlineIconFontSize">16</x:Double>
            <x:Double x:Key="LayoutSecureBootMetricsColumnSpacing">28</x:Double>
            <x:Double x:Key="LayoutMetricSpacing">4</x:Double>
            <x:Double x:Key="LayoutMetricValueFontSize">18</x:Double>
            <x:Double x:Key="LayoutMetricCaptionOpacity">0.62</x:Double>
            <x:Double x:Key="LayoutCertificateListSpacing">12</x:Double>
            <x:Double x:Key="LayoutCertificateItemSpacing">8</x:Double>
            <Thickness x:Key="LayoutCertificateItemPadding">16,12</Thickness>
            <Thickness x:Key="LayoutCertificateItemBorderThickness">1</Thickness>
            <CornerRadius x:Key="LayoutCertificateItemCornerRadius">8</CornerRadius>
            <x:Double x:Key="LayoutWideActionSpacing">16</x:Double>
            <x:Double x:Key="LayoutStackedActionSpacing">12</x:Double>
            <x:Double x:Key="LayoutSecondaryTextOpacity">0.65</x:Double>
            <x:Double x:Key="LayoutHintTextOpacity">0.70</x:Double>
            <x:Double x:Key="LayoutFileLabelOpacity">0.72</x:Double>
            <x:Double x:Key="LayoutEmptyIconOpacity">0.30</x:Double>
            <x:Double x:Key="LayoutBootLogoPreviewHeight">240</x:Double>

            <Thickness x:Key="LayoutContentHostMarginDefault">0</Thickness>
            <Thickness x:Key="LayoutContentPaddingNarrow">12</Thickness>
            <Thickness x:Key="LayoutContentPaddingMedium">24</Thickness>
            <Thickness x:Key="LayoutContentPaddingWide">24</Thickness>
            <Thickness x:Key="LayoutStatusPaddingNarrow">12</Thickness>
            <Thickness x:Key="LayoutStatusPaddingMedium">24,12</Thickness>
            <Thickness x:Key="LayoutStatusPaddingWide">24,12</Thickness>
            <Thickness x:Key="LayoutCurrentFileMargin">4,0,4,12</Thickness>
            <Thickness x:Key="LayoutCardPadding">24</Thickness>
            <Thickness x:Key="LayoutEmptyPadding">16,32</Thickness>
            <Thickness x:Key="LayoutStatusBorderThickness">0,1,0,0</Thickness>
            <Thickness x:Key="LayoutCardBorderThickness">1</Thickness>
            <CornerRadius x:Key="LayoutCardCornerRadius">8</CornerRadius>

            <!-- Reusable component styles use the Windows type ramp instead of custom font sizes. -->
            <Style
                x:Key="PageHeadingTextStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style
                x:Key="SectionTitleTextStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource LayoutCardPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource LayoutCardCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource LayoutCardBorderThickness}" />
            </Style>
            <!-- Driver cards keep ThemeResource references in XAML. Do not resolve these brushes in code:
                 a resolved Brush is a theme snapshot and does not follow RequestedTheme changes. -->
            <Style x:Key="UefiDriverBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource LayoutCertificateItemPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource LayoutCertificateItemCornerRadius}" />
                <Setter Property="BorderThickness" Value="{StaticResource LayoutCertificateItemBorderThickness}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="UefiDriverWarningBorderStyle" TargetType="Border" BasedOn="{StaticResource UefiDriverBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="UefiDriverErrorBorderStyle" TargetType="Border" BasedOn="{StaticResource UefiDriverBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="UefiDriverInformationBorderStyle" TargetType="Border" BasedOn="{StaticResource UefiDriverBorderStyle}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="UefiDriverSuccessTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="UefiDriverWarningTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="UefiDriverErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="UefiDriverInformationTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style
                x:Key="PrimaryActionButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource AccentButtonStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

